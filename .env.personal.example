# Copy this file to .env.personal in the repository root. Never commit that copy.
# Required: OpenAI-compatible /chat/completions service with tool calling.
EVOAGENT_API_KEY=
EVOAGENT_BASE_URL=
EVOAGENT_MODEL=
# Set this to the documented context window of the selected model.
EVOAGENT_CONTEXT_WINDOW_TOKENS=

# No-key public search; use mock for offline tests or brave with a separate key.
EVOAGENT_SEARCH_PROVIDER=ddgs
EVOAGENT_SEARCH_API_KEY=

# Optional for providers that require non-thinking tool-call mode, e.g. tested DeepSeek setup.
# EVOAGENT_PROVIDER_THINKING_MODE=disabled

# Commands are off until the executable names present inside the Worker image are listed.
# Only recognizable offline checks run without an extra decision; builds/installs need approval.
# EVOAGENT_PROJECT_COMMAND_ALLOWLIST='["python","pytest","node","npm","git","rg"]'

# Paid development trials require an explicit numeric cap and a documented price assumption.
# The following are examples, not current prices; check the provider before setting them.
# EVOAGENT_BUDGET_SCOPE=trial
# EVOAGENT_BUDGET_TRIAL_LIMIT_MICROS=5000000
# EVOAGENT_BUDGET_TASK_LIMIT_MICROS=1000000
# EVOAGENT_BUDGET_INPUT_PRICE_MICROS_PER_MILLION=
# EVOAGENT_BUDGET_OUTPUT_PRICE_MICROS_PER_MILLION=
