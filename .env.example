# 默认开发环境使用行为确定的 MockProvider。
EVOAGENT_PROVIDER=mock

# 仅当 EVOAGENT_PROVIDER=openai_compatible 时才需要填写。
EVOAGENT_API_KEY=
EVOAGENT_BASE_URL=
EVOAGENT_MODEL=

EVOAGENT_MAX_ITERATIONS=8
EVOAGENT_MODEL_TIMEOUT_SECONDS=60
EVOAGENT_TASK_TIMEOUT_SECONDS=300
EVOAGENT_TOOL_TIMEOUT_SECONDS=30
EVOAGENT_MAX_TOTAL_TOKENS=32000
EVOAGENT_MAX_REPEATED_TOOL_CALLS=3
EVOAGENT_MAX_TOOL_RESULT_CHARS=20000
EVOAGENT_WORKSPACE=./workspace
EVOAGENT_LOG_LEVEL=INFO

# 阶段二持久化、API 和单 Worker 配置。
EVOAGENT_DATABASE_URL=postgresql+asyncpg://evoagent:evoagent@127.0.0.1:5432/evoagent
EVOAGENT_API_HOST=127.0.0.1
EVOAGENT_API_PORT=8000
EVOAGENT_WORKER_ID=worker-local
EVOAGENT_WORKER_POLL_SECONDS=1
EVOAGENT_LEASE_SECONDS=30
EVOAGENT_HEARTBEAT_SECONDS=10
EVOAGENT_SNAPSHOT_SCHEMA_VERSION=1
EVOAGENT_ARTIFACT_ROOT=./workspace/artifacts
EVOAGENT_FRONTEND_DIST=./frontend/dist
EVOAGENT_MAX_RETRY_ATTEMPTS=3
EVOAGENT_RETRY_BASE_SECONDS=1
EVOAGENT_RETRY_MAX_SECONDS=30
EVOAGENT_RETRY_MAX_ELAPSED_SECONDS=300
EVOAGENT_SSE_POLL_SECONDS=0.5
EVOAGENT_SSE_HEARTBEAT_SECONDS=15
# 默认空列表代表关闭 Shell；确有需要时按部署环境填写最小白名单。
EVOAGENT_SHELL_ALLOWED_EXECUTABLES='[]'
EVOAGENT_SEARCH_PROVIDER=mock
EVOAGENT_SEARCH_API_KEY=

# 阶段三声明式 Skill 与评测基础配置。
EVOAGENT_CODE_VERSION=0.3.0.dev0
EVOAGENT_SKILL_SCHEMA_VERSION=1
EVOAGENT_SKILL_MAX_STEPS=20
EVOAGENT_SKILL_MAX_SOURCES=10
EVOAGENT_SKILL_MIN_SOURCES=2
EVOAGENT_SKILL_RETRIEVAL_TOP_K=1
EVOAGENT_SKILL_RETRIEVAL_MIN_SCORE=0.1
EVOAGENT_SKILL_MAX_EFFECTIVE_RISK=R1
EVOAGENT_SKILL_ALLOWED_TOOLS='["calculator","file_read","web_fetch","web_search","artifact_write"]'
EVOAGENT_SKILL_EXTRACTOR_MODEL=
EVOAGENT_EVAL_DATASET_ROOT=./evals/datasets
EVOAGENT_EVAL_REPEATS=3
EVOAGENT_EVAL_POLL_SECONDS=1
EVOAGENT_EVAL_LEASE_SECONDS=60
